PORT=3938
CONFIG_DIR=/config
APP_NAME=H&H Media Guard
SUITE_NAME=H&H Suite
APP_URL=http://localhost:3938
ALLOWED_ORIGINS=
ENCRYPTION_KEY=generate-a-32-byte-base64-value-before-startup
ALLOW_DESTRUCTIVE_ACTIONS=false
MOVIES_PATH=./sample-media
TV_PATH=./sample-media

# Optional non-root application IDs; Unraid template uses 99:100.
PUID=100
PGID=101
